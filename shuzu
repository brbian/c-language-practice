#include <stdio.h>
int main(){
    char s[10005]={0};
    int i;
    scanf("%[^\n]",s);
    for(i=0;s[i]!='\0';i++){
        if(s[i]>='a'&&s[i]<='z'){
            if(s[i]=='a')s[i]='z';
            else s[i]--;}/*s[i]=s[i]-1,将当前字母变成上一个字母*/
        else if(s[i]>='A'&&s[i]<='Z')
           {if(s[i]=='A')s[i]='Z';
           else s[i]--;}
    }
    printf("%s\n",s);
    return 0;
}
